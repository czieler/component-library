{
  "name": "@czieler/ui-react",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc -b --pretty false",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:package": "tsc -p tsconfig.package.json && vite build --config vite.package.config.ts && node scripts/build-package-css.mjs scss",
    "prepack": "npm run check && npm run build:package"
  },
  "dependencies": {
    "lucide-react": "1.35.0"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "sass": "1.103.1",
    "@vitejs/plugin-react": "6.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  },
  "description": "Reusable React and TypeScript UI components and design system",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/czieler/component-library.git",
    "directory": "react"
  },
  "homepage": "https://github.com/czieler/component-library",
  "files": [
    "dist-package"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist-package/index.js",
  "module": "./dist-package/index.js",
  "exports": {
    ".": {
      "types": "./dist-package/index.d.ts",
      "default": "./dist-package/index.js"
    },
    "./styles.css": "./dist-package/styles.css"
  },
  "style": "./dist-package/styles.css",
  "publishConfig": {
    "access": "public"
  },
  "types": "./dist-package/index.d.ts",
  "peerDependencies": {
    "react": ">=18 <20",
    "react-dom": ">=18 <20"
  }
}
